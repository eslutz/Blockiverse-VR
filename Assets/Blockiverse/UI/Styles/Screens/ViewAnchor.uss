/*
 * ViewAnchor — layout only. A single dot, centred in its panel.
 *
 * The panel paints nothing: no surface, no border, no padding. Everything else in the HUD family
 * is a plate the player reads; this is one mark on an otherwise empty document, and any backing at
 * the centre of vision would be exactly the intrusion the comfort setting exists to avoid.
 */

.va-root {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
}

/* 10 px is 10 mm at the project's 100 pixels-per-unit and 0.1 panel scale — about half a degree at
   the 1.10 m HUD distance. Deliberately at the small end: the work that motivates having an anchor
   at all also found that a larger visual guide costs presence, so this is the one element where
   growing it "to be safe" makes it worse.

   Bone centre on a dark ring, so it holds against both a snow biome and a cave without needing to
   be re-tinted per environment — a dot tuned for one is invisible in the other. */
.va-dot {
    width: 10px;
    height: 10px;
    background-color: var(--hs-ink);
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-color: var(--hs-void);
    border-left-color: var(--hs-void);
    border-right-color: var(--hs-void);
    border-bottom-color: var(--hs-void);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

/* Hidden by collapsing the DOT, not the root.

   The root cannot carry this: UiToolkitScreenController.SetVisible writes an inline style.display
   onto bv-screen-root whenever the router shows the HUD, and a UI Toolkit inline style outranks
   every stylesheet rule (USS has no !important). A `display: none` keyed on the root is therefore
   silently discarded, which left a permanent dot at the exact centre of vision — the one failure
   this off-by-default setting exists to prevent.

   Collapsing the dot costs nothing the root would have saved: display:none removes it from layout
   entirely, so there is no measure pass for a single 10 px element either way. */
.va-dot--hidden {
    display: none;
}
