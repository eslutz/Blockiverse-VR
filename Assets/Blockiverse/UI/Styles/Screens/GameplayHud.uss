/*
 * GameplayHud — layout only. The action bar: four panel-open buttons sharing one row. Colours,
 * spacing steps and type sizes all resolve from Tokens/Base.
 *
 * The health readout's rules used to live here and no longer do. When the HUD split into an
 * action bar and a stats readout, the markup moved to GameplayStats.uxml but the gh-health-*
 * rules stayed behind — and because the bootstrapper resolves a screen's sheet by DOCUMENT NAME,
 * they were never loaded for the document that used them. The health bar had no height and no
 * fill colour, and nothing reported it. They now live in GameplayStats.uss, next to the document
 * that owns them, and ScreenStyleSheetReachabilityEditModeTests fails if they ever drift apart
 * again.
 */

.gh-actions {
    flex-direction: row;
    margin-top: var(--hs-space-1);
}

.gh-action {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: var(--hs-space-1);
    margin-right: var(--hs-space-1);
}
