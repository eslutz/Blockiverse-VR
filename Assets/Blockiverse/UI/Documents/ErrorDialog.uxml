<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" editor-extension-mode="False">
    <!--
        Error modal (MenuActions.ErrorModal). Every string on this screen is runtime data:
        BlockiverseMenuController.ShowError pushes the (already localized) title with the
        action list via SetActionMenu, the message via SetScreenStatus, and
        ErrorDialogController builds the close-button row from the pushed MenuAction list —
        so no element here carries a static literal or a LocalizedString binding.

        Stylesheets are attached by the controller/bootstrapper from serialized references
        (Tokens.uss, Base.uss, Styles/Screens/ErrorDialog.uss); a UXML <Style src> would need
        pre-import GUIDs and is banned.
    -->
    <engine:VisualElement name="bv-screen-root" class="hs-screen">
        <engine:VisualElement name="bv-error-header" class="hs-screen__header" picking-mode="Ignore">
            <engine:Label name="bv-error-title" class="hs-screen__title" picking-mode="Ignore" />
        </engine:VisualElement>
        <engine:VisualElement name="bv-error-content" class="hs-screen__content" picking-mode="Ignore">
            <engine:Label name="bv-error-message" class="hs-status hs-status--rejected" picking-mode="Ignore" />
            <engine:VisualElement name="bv-error-actions" picking-mode="Ignore" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
