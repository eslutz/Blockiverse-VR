<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" editor-extension-mode="False">
    <!--
        Quick block menu (matrix row 24). Not a routed screen: CreativeHotbarController
        implements IUiToolkitQuickBlockMenu, so UiToolkitMenuHost excludes it from routed
        visibility and toggles it from the quick-menu hardware button while the gameplay HUD
        is the routed screen. The selected-block label is dynamic; the slot buttons (one per
        selectable catalog block) are rendered by the controller, so the document carries no
        static button text.
    -->
    <engine:VisualElement name="bv-screen-root" class="hs-screen">
        <engine:VisualElement name="bv-hotbar-header" class="hs-screen__header" picking-mode="Ignore">
            <engine:Label name="bv-hotbar-title" text="Blocks" class="hs-screen__title" picking-mode="Ignore">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="UI" entry="ui.generated.blocks.title" />
                </Bindings>
            </engine:Label>
            <engine:Label name="bv-hotbar-selected" class="hs-secondary ch-selected" picking-mode="Ignore" />
        </engine:VisualElement>
        <engine:ScrollView name="bv-hotbar-slots" class="hs-screen__content" mode="Vertical" />
    </engine:VisualElement>
</engine:UXML>
