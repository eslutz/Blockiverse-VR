<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" editor-extension-mode="False">
    <!--
        Title menu (screen id title_menu). Every visible string arrives at runtime through
        IUiToolkitActionMenuScreen.SetActionMenu — the title is BlockiverseProject.ProductName
        and the button list varies with save availability — so this document carries no static
        text and no localization bindings. Buttons are created by TitleScreenController.
    -->
    <engine:VisualElement name="bv-screen-root" class="hs-screen">
        <engine:VisualElement name="bv-header" class="hs-screen__header" picking-mode="Ignore">
            <engine:Label name="bv-title" class="hs-screen__title" picking-mode="Ignore" />
        </engine:VisualElement>
        <engine:ScrollView name="bv-actions" class="hs-screen__content hs-action-list" mode="Vertical" />
        <engine:VisualElement name="bv-footer" class="hs-screen__footer" picking-mode="Ignore">
            <engine:Label name="bv-status" class="hs-status" picking-mode="Ignore" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
